# PostgreSQL connection string for the backend
DATABASE_URL=jdbc:postgresql://localhost:5432/docpilot

# Base URL of the AI Worker service
AI_WORKER_BASE_URL=http://localhost:8000

# Qdrant vector database (local docker)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=docpilot

# Gemini API key for embeddings and generation
GEMINI_API_KEY=your-gemini-api-key
